@model InventorySystem.Models.Sale
@{
    ViewData["Title"] = "Sale Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Sale #@Model.SaleID</h2>
        <div class="text-muted">@Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</div>
    </div>
    <div>
        <a asp-action="Receipt" asp-route-id="@Model.SaleID" class="btn btn-success">Receipt</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Customer</h5>
            <div>@Model.CustomerInfo</div>
        </div>
    </div>
    <div class="col-md-8">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.SaleItems)
                {
                    <tr>
                        <td>@i.Product.ProductName</td>
                        <td>@i.UnitPrice.ToString("C")</td>
                        <td>@i.Quantity</td>
                        <td>@i.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
        <h4 class="text-end">Total: @Model.TotalAmount.ToString("C")</h4>
    </div>
</div>